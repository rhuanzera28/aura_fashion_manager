<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aura Fashion - Cronograma do Projeto</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #111111;
            color: #ffffff;
            padding: 40px;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        header {
            text-align: center;
            margin-bottom: 45px;
        }

        .logo {
            font-size: 42px;
            font-weight: 300;
            letter-spacing: 8px;
            color: #f5c76a;
            margin-bottom: 10px;
        }

        header h2 {
            font-size: 24px;
            font-weight: 400;
            color: #eeeeee;
        }

        header p {
            margin-top: 10px;
            color: #999999;
            font-size: 15px;
        }

        .timeline {
            position: relative;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .timeline::before {
            content: "";
            position: absolute;
            top: 32px;
            left: 7%;
            right: 7%;
            height: 2px;
            background: #f5c76a;
            z-index: 0;
        }

        .sprint {
            position: relative;
            z-index: 1;
            background: #1c1c1c;
            border: 1px solid #333333;
            border-radius: 14px;
            overflow: hidden;
            transition: 0.3s;
        }

        .sprint:hover {
            transform: translateY(-5px);
            border-color: #f5c76a;
        }

        .sprint-header {
            background: #242424;
            padding: 22px;
            text-align: center;
            border-bottom: 1px solid #333333;
        }

        .sprint-number {
            width: 45px;
            height: 45px;
            line-height: 45px;
            margin: 0 auto 12px;
            border-radius: 50%;
            background: #f5c76a;
            color: #111111;
            font-weight: bold;
            font-size: 18px;
        }

        .sprint-header h3 {
            font-size: 20px;
            color: #ffffff;
        }

        .period {
            margin-top: 7px;
            color: #f5c76a;
            font-size: 14px;
            font-weight: bold;
        }

        .sprint-content {
            padding: 24px;
        }

        .sprint-content h4 {
            color: #f5c76a;
            margin-bottom: 12px;
            font-size: 16px;
        }

        ul {
            list-style: none;
            margin-bottom: 25px;
        }

        li {
            margin-bottom: 10px;
            color: #cccccc;
            font-size: 14px;
            line-height: 1.4;
        }

        li::before {
            content: "✓";
            color: #f5c76a;
            font-weight: bold;
            margin-right: 8px;
        }

        .price {
            border-top: 1px solid #333333;
            padding-top: 18px;
            text-align: center;
        }

        .price span {
            display: block;
            color: #888888;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .price strong {
            font-size: 24px;
            color: #f5c76a;
        }

        .total {
            margin-top: 40px;
            background: #1c1c1c;
            border: 1px solid #f5c76a;
            border-radius: 14px;
            padding: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total h3 {
            font-size: 20px;
            font-weight: 400;
        }

        .total p {
            color: #999999;
            margin-top: 6px;
            font-size: 14px;
        }

        .total-value {
            font-size: 32px;
            color: #f5c76a;
            font-weight: bold;
        }

        .project-info {
            margin-top: 40px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .info-card {
            background: #1c1c1c;
            border-radius: 12px;
            padding: 22px;
            border: 1px solid #333333;
        }

        .info-card h4 {
            color: #f5c76a;
            margin-bottom: 10px;
        }

        .info-card p {
            color: #bbbbbb;
            font-size: 14px;
            line-height: 1.5;
        }

        @media (max-width: 900px) {
            .timeline {
                grid-template-columns: repeat(2, 1fr);
            }

            .timeline::before {
                display: none;
            }
        }

        @media (max-width: 600px) {
            body {
                padding: 20px;
            }

            .timeline,
            .project-info {
                grid-template-columns: 1fr;
            }

            .total {
                flex-direction: column;
                text-align: center;
                gap: 20px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <header>
        <div class="logo">AURA FASHION</div>
        <h2>Cronograma de Desenvolvimento do Sistema</h2>
        <p>Sistema Administrativo Integrado para Loja de Roupas</p>
    </header>

    <section class="timeline">

        <!-- SPRINT 1 -->
        <div class="sprint">

            <div class="sprint-header">
                <div class="sprint-number">1</div>
                <h3>Sprint 01</h3>
                <div class="period">Semanas 1 e 2</div>
            </div>

            <div class="sprint-content">

                <h4>Estrutura e Acesso</h4>

                <ul>
                    <li>Levantamento das necessidades da loja</li>
                    <li>Definição da arquitetura do sistema</li>
                    <li>Tela de login</li>
                    <li>Cadastro de usuários</li>
                    <li>Controle de permissões</li>
                    <li>Dashboard inicial</li>
                </ul>

                <div class="price">
                    <span>Valor da Sprint</span>
                    <strong>R$ 3.000,00</strong>
                </div>

            </div>
        </div>


        <!-- SPRINT 2 -->
        <div class="sprint">

            <div class="sprint-header">
                <div class="sprint-number">2</div>
                <h3>Sprint 02</h3>
                <div class="period">Semanas 3 e 4</div>
            </div>

            <div class="sprint-content">

                <h4>Comercial e Estoque</h4>

                <ul>
                    <li>Cadastro de produtos</li>
                    <li>Controle de tamanhos e cores</li>
                    <li>Controle de estoque</li>
                    <li>Registro de vendas</li>
                    <li>Cadastro de clientes</li>
                    <li>Alertas de estoque baixo</li>
                </ul>

                <div class="price">
                    <span>Valor da Sprint</span>
                    <strong>R$ 5.000,00</strong>
                </div>

            </div>
        </div>


        <!-- SPRINT 3 -->
        <div class="sprint">

            <div class="sprint-header">
                <div class="sprint-number">3</div>
                <h3>Sprint 03</h3>
                <div class="period">Semanas 5 e 6</div>
            </div>

            <div class="sprint-content">

                <h4>CRM e Financeiro</h4>

                <ul>
                    <li>Histórico de compras dos clientes</li>
                    <li>Funil de vendas CRM</li>
                    <li>Cadastro de oportunidades</li>
                    <li>Controle de pagamentos</li>
                    <li>Contas a pagar e receber</li>
                    <li>Relatórios financeiros</li>
                </ul>

                <div class="price">
                    <span>Valor da Sprint</span>
                    <strong>R$ 4.500,00</strong>
                </div>

            </div>
        </div>


        <!-- SPRINT 4 -->
        <div class="sprint">

            <div class="sprint-header">
                <div class="sprint-number">4</div>
                <h3>Sprint 04</h3>
                <div class="period">Semanas 7 e 8</div>
            </div>

            <div class="sprint-content">

                <h4>RH e Integração</h4>

                <ul>
                    <li>Cadastro de funcionários</li>
                    <li>Controle de férias</li>
                    <li>Contratações e demissões</li>
                    <li>Folha de pagamento</li>
                    <li>Integração entre os módulos</li>
                    <li>Testes e correções finais</li>
                </ul>

                <div class="price">
                    <span>Valor da Sprint</span>
                    <strong>R$ 4.000,00</strong>
                </div>

            </div>
        </div>

    </section>


    <!-- TOTAL -->
    <section class="total">

        <div>
            <h3>Investimento Total do Projeto</h3>
            <p>Desenvolvimento completo do sistema Aura Fashion</p>
        </div>

        <div class="total-value">
            R$ 16.500,00
        </div>

    </section>


    <!-- INFORMAÇÕES -->
    <section class="project-info">

        <div class="info-card">
            <h4>⏱ Duração</h4>
            <p>
                8 semanas de desenvolvimento,
                divididas em 4 Sprints de 2 semanas.
            </p>
        </div>

        <div class="info-card">
            <h4>👥 Equipe</h4>
            <p>
                Equipe composta por 3 integrantes,
                utilizando princípios da metodologia Scrum.
            </p>
        </div>

        <div class="info-card">
            <h4>🔗 Integração</h4>
            <p>
                Os módulos Financeiro, Comercial,
                Estoque e RH estarão integrados.
            </p>
        </div>

    </section>

</div>

</body>
</html>
